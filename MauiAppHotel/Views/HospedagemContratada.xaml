<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="Sua hospedagem"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="ALMARE RESORT"
                   FontSize="15"
                   FontAttributes="Bold"
                   CharacterSpacing="3"
                   TextColor="{StaticResource Azul}"
                   HorizontalOptions="Center"/>

            <!-- RESUMO DA RESERVA -->

            <VerticalStackLayout x:Name="layoutResumo"
                                 Spacing="16">

                <Label Text="Confira sua hospedagem"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Azul}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Confira todos os detalhes antes de confirmar."
                       FontSize="14"
                       TextColor="{StaticResource TextoSecundario}"
                       HorizontalTextAlignment="Center"/>

                <Frame BackgroundColor="{StaticResource CardBackground}"
                       BorderColor="{StaticResource Gray200}"
                       CornerRadius="16"
                       Padding="20">

                    <VerticalStackLayout Spacing="13">

                        <Label Text="RESUMO DA RESERVA"
                               FontSize="13"
                               CharacterSpacing="2"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <Label Text="Acomodação"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_quarto"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_camas"
                               FontSize="14"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Hóspedes"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_hospedes"
                               TextColor="{StaticResource Azul}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Período"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_periodo"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_noites"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Investimento"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_diaria"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_total"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                    </VerticalStackLayout>
                </Frame>

                <Button Text="Confirmar reserva"
                        Clicked="OnConfirmarClicked"
                        BackgroundColor="{StaticResource Azul}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="52"/>

                <Button Text="Voltar"
                        Clicked="OnVoltarClicked"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Azul}"
                        BorderColor="{StaticResource Azul}"
                        BorderWidth="1"
                        CornerRadius="12"
                        HeightRequest="48"/>

            </VerticalStackLayout>

            <!-- RESERVA CONFIRMADA -->

            <VerticalStackLayout x:Name="layoutConfirmacao"
                                 IsVisible="False"
                                 Spacing="16">

                <Label Text="✓"
                       FontSize="55"
                       FontAttributes="Bold"
                       TextColor="{StaticResource TextoSecundario}"
                       HorizontalOptions="Center"/>

                <Label Text="Sua reserva está confirmada!"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Azul}"
                       HorizontalTextAlignment="Center"/>

                <Label Text="Obrigado por escolher o Almare Resort. Estamos esperando por você!"
                       FontSize="14"
                       TextColor="{StaticResource TextoSecundario}"
                       HorizontalTextAlignment="Center"/>

                <Frame BackgroundColor="{StaticResource CardBackground}"
                       BorderColor="{StaticResource Gray200}"
                       CornerRadius="16"
                       Padding="20">

                    <VerticalStackLayout Spacing="13">

                        <Label Text="SUA RESERVA"
                               FontSize="13"
                               CharacterSpacing="2"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <Label x:Name="lbl_codigo"
                               FontSize="13"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <Label x:Name="lbl_quartoFinal"
                               FontSize="21"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_camasFinal"
                               TextColor="{StaticResource Azul}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Hóspedes"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_hospedesFinal"
                               TextColor="{StaticResource Azul}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Check-in e check-out"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_periodoFinal"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_noitesFinal"
                               TextColor="{StaticResource TextoSecundario}"/>

                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Gray200}"/>

                        <Label Text="Valor total"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                        <Label x:Name="lbl_totalFinal"
                               FontSize="25"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Azul}"/>

                    </VerticalStackLayout>
                </Frame>

                <Label Text="Almare Resort • Um refúgio para renovar os sentidos."
                       FontSize="11"
                       TextColor="{StaticResource TextoSecundario}"
                       HorizontalTextAlignment="Center"/>

                <Button Text="Concluir"
                        Clicked="OnInicioClicked"
                        BackgroundColor="{StaticResource Azul}"
                        TextColor="{StaticResource White}"
                        CornerRadius="12"
                        FontAttributes="Bold"
                        HeightRequest="52"/>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
