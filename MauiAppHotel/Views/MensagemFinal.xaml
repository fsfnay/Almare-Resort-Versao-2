<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.MensagemFinal"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#263746">

    <Grid Padding="28" RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="26">

            <Label Text="ALMARE RESORT"
                   FontSize="25"
                   FontAttributes="Bold"
                   CharacterSpacing="4"
                   TextColor="#E2C58C"
                   HorizontalTextAlignment="Center" />

            <Label Text="SUA EXPERIÊNCIA COMEÇA AQUI"
                   FontSize="11"
                   CharacterSpacing="2"
                   TextColor="#D7DCE0"
                   HorizontalTextAlignment="Center" />

            <BoxView HeightRequest="1"
                     WidthRequest="100"
                     Color="#B99B65"
                     HorizontalOptions="Center" />

            <Label Text="Será um prazer receber você!"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Label Text="Sua estadia está preparada para proporcionar momentos especiais, tranquilidade e conforto."
                   FontSize="16"
                   LineHeight="1.3"
                   TextColor="#E4E8EA"
                   HorizontalTextAlignment="Center"
                   HorizontalOptions="Center" />

            <Label Text="Estamos esperando por você. Até breve!"
                   FontSize="16"
                   FontAttributes="Italic"
                   TextColor="#E2C58C"
                   HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="VOLTAR AO INÍCIO"
                    Clicked="OnInicioClicked"
                    BackgroundColor="#D4B77D"
                    TextColor="#263746"
                    FontAttributes="Bold"
                    CharacterSpacing="1.5"
                    CornerRadius="12"
                    HeightRequest="54" />

            <Label Text="ALMARE RESORT • UM REFÚGIO PARA RENOVAR OS SENTIDOS"
                   FontSize="9"
                   CharacterSpacing="1"
                   TextColor="#BFC9CF"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
