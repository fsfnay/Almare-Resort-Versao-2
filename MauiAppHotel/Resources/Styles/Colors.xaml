<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta oficial Almare Resort -->

    <Color x:Key="OffWhite">#F3F0E9</Color>
    <Color x:Key="Azul">#496779</Color>
    <Color x:Key="AreiaDourada">#A87945</Color>
    <Color x:Key="Chumbo">#303B3C</Color>

    <!-- Cores principais do MAUI -->

    <Color x:Key="Primary">#496779</Color>
    <Color x:Key="PrimaryDark">#303B3C</Color>
    <Color x:Key="PrimaryDarkText">#303B3C</Color>

    <Color x:Key="Secondary">#A87945</Color>
    <Color x:Key="SecondaryDarkText">#303B3C</Color>
    <Color x:Key="Tertiary">#A87945</Color>

    <!-- Cores neutras -->

    <Color x:Key="White">#F3F0E9</Color>
    <Color x:Key="Black">#303B3C</Color>
    <Color x:Key="Magenta">#A87945</Color>
    <Color x:Key="MidnightBlue">#303B3C</Color>
    <Color x:Key="OffBlack">#303B3C</Color>

    <!-- Escala de cinza adaptada à identidade visual -->

    <Color x:Key="Gray100">#F3F0E9</Color>
    <Color x:Key="Gray200">#A87945</Color>
    <Color x:Key="Gray300">#A87945</Color>
    <Color x:Key="Gray400">#496779</Color>
    <Color x:Key="Gray500">#496779</Color>
    <Color x:Key="Gray600">#303B3C</Color>
    <Color x:Key="Gray900">#303B3C</Color>
    <Color x:Key="Gray950">#303B3C</Color>

    <!-- Brushes -->

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

</ResourceDictionary>
